local function DisableChair(obj)
	if obj:IsA("Seat") or obj:IsA("VehicleSeat") then
		pcall(function()
			obj.Disabled = true
			obj.CanTouch = false
			obj.CanCollide = false
		end)
	elseif obj.Name == "SeatWeld" and obj:IsA("Weld") then
		pcall(function() obj:Destroy() end)
	end
end

