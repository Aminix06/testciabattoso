local function SetupAntiSitOnCharacter(char)
	if not char then return end
	table.clear(cachedCharParts)
	for _, part in ipairs(char:GetDescendants()) do
		if part:IsA("BasePart") then table.insert(cachedCharParts, part) end
	end
	table.insert(connections, char.DescendantAdded:Connect(function(part)
		if part:IsA("BasePart") then table.insert(cachedCharParts, part) end
	end))

	task.spawn(function()
		local hum = char:WaitForChild("Humanoid", 8)
		if hum then
			pcall(function()
				hum:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
