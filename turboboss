local equippedSkills = {}

local function CheckAndEquipSkills(forceReEquip)
	if forceReEquip then
		table.clear(equippedSkills)
	end

	local playerData = ReplicatedStorage:FindFirstChild("Datas") and ReplicatedStorage.Datas:FindFirstChild(tostring(localPlayer.UserId))
	if not playerData then return end

	local myStr = tonumber(playerData:FindFirstChild("Strength") and playerData.Strength.Value) or 0
	local mySpd = tonumber(playerData:FindFirstChild("Speed") and playerData.Speed.Value) or 0
	local myReb = tonumber(playerData:FindFirstChild("Rebirth") and playerData.Rebirth.Value) or 0

	for _, skill in ipairs(SkillRequirements) do
		if myStr >= skill.MinStat and mySpd >= skill.MinStat and myReb >= skill.MinReb then
			if not equippedSkills[skill.Name] then
				pcall(function()
					equipRemote:InvokeServer(skill.Name)
					equippedSkills[skill.Name] = true
				end)
				task.wait(0.1)
			end
		else
			equippedSkills[skill.Name] = false
		end
	end
end

task.spawn(function() CheckAndEquipSkills(true) end)

task.spawn(function()
	while IsCurrentSession() do
		if getgenv().AutoFarmActive and not isCurrentlyAttacking then
			CheckAndEquipSkills(false)
