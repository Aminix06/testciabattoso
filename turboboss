local function TweenAndFight(bossEntry, hasQuestNpc)
	local playerData = ReplicatedStorage.Datas:FindFirstChild(tostring(localPlayer.UserId))
	local questVal = playerData and playerData:FindFirstChild("Quest")

	CheckAndEquipSkills(false)

	while IsCurrentSession() and getgenv().AutoFarmActive and not justRebirthed do
		if getgenv().ManualBoss and getgenv().ManualBoss ~= bossEntry.Name then break end
		if NeedsFormOrKaiokenRightNow() then break end

		local myDef = tonumber(playerData and playerData:FindFirstChild("Defense") and playerData.Defense.Value) or 0
		if not getgenv().ManualBoss and myDef < bossEntry.MinDef then break end

		if hasQuestNpc and questVal then
			if questVal.Value ~= bossEntry.Name and questVal.Value ~= bossEntry.Boss then break end
			if not getgenv().ManualBoss and GetStrongerNoQuestBoss(myDef, bossEntry.MinDef) then break end
		end

		local currentBoss = FindLivingBoss(bossEntry)
		if not currentBoss then break end

		local bossHRP = currentBoss:FindFirstChild("HumanoidRootPart")
		local bossHum = currentBoss:FindFirstChildOfClass("Humanoid")
		local character = localPlayer.Character
		local hrp = character and character:FindFirstChild("HumanoidRootPart")
		if not bossHRP or not bossHum or not hrp then break end

		currentLockedBoss = currentBoss
		EnsureServerLockOn(currentBoss)

		local distToBoss = (hrp.Position - bossHRP.Position).Magnitude
		local hpRatio = bossHum.Health / math.max(bossHum.MaxHealth, 1)

		if distToBoss > 25 then
			isCurrentlyAttacking = false
			SetStatus("✈️ Tween -> " .. bossEntry.Name, hpRatio)
			local behindOffset = bossHRP.CFrame.LookVector * behindDistance
			local targetCF = CFrame.new(bossHRP.Position + behindOffset, bossHRP.Position)
			pcall(function() MoveToTarget(targetCF, false) end)
		else
			local wsChar = workspace:FindFirstChild("Living") and workspace.Living:FindFirstChild(localPlayer.Name)
			local kiObj = wsChar and wsChar:FindFirstChild("Stats") and wsChar.Stats:FindFirstChild("Ki")
			if kiObj and (tonumber(kiObj.Value) or 100) < 10 then
				isCurrentlyAttacking = false
				SetStatus("⚡ Ricarica rapida Ki...", hpRatio)
				task.wait(0.35)
			else
				isCurrentlyAttacking = true
				local hpPct = math.floor(hpRatio * 100)
				SetStatus(string.format("⚔️ %s [%d%%]", bossEntry.Name, hpPct), hpRatio)
				DoFullAttack(currentBoss, bossEntry)
			end
		end

		task.wait(0.1)
	end

	isCurrentlyAttacking = false
	currentLockedBoss = nil
	lastServerLockedBoss = nil
	StopActiveTween()
	pcall(function()
		camera.CameraType = Enum.CameraType.Custom
		if localPlayer.Character and localPlayer.Character:FindFirstChildOfClass("Humanoid") then
			localPlayer.Character:FindFirstChildOfClass("Humanoid").AutoRotate = true
			camera.CameraSubject = localPlayer.Character:FindFirstChildOfClass("Humanoid")
		end
	end)
end

local function WaitForBossToSpawnAndCompleteQuest(bossEntry, hasQuestNpc, questVal)
	isCurrentlyAttacking = false
	currentLockedBoss = nil
	lastServerLockedBoss = nil

	if bossEntry.NoQuest then
		confirmedNoQuestBosses[bossEntry.Name] = true
		lastActiveNoQuestBoss = bossEntry.Name
	end

	while IsCurrentSession() and getgenv().AutoFarmActive and not justRebirthed do
		if getgenv().ManualBoss and getgenv().ManualBoss ~= bossEntry.Name then return true end
		local char = localPlayer.Character
		if not char or not char:FindFirstChildOfClass("Humanoid") or char.Humanoid.Health <= 0 then return true end

		if NeedsFormOrKaiokenRightNow() then
			if not EnsureFormAndKaioken() then return true end
		end

		local pData = ReplicatedStorage.Datas:FindFirstChild(tostring(localPlayer.UserId))
		local myDef = tonumber(pData and pData:FindFirstChild("Defense") and pData.Defense.Value) or 0
		if not getgenv().ManualBoss then
			if myDef < bossEntry.MinDef then return true end
			if not hasQuestNpc and HasStrongerBossAvailableInMap(bossEntry.MinDef, myDef) then return true end
			if hasQuestNpc and GetStrongerNoQuestBoss(myDef, bossEntry.MinDef) then return true end
		end

		if hasQuestNpc and questVal and questVal.Value ~= bossEntry.Name and questVal.Value ~= bossEntry.Boss then
			return true
		end

		local currentBoss = FindLivingBoss(bossEntry)
		if currentBoss then
			task.wait(0.08)
			TweenAndFight(bossEntry, hasQuestNpc)
		else
			SetStatus("⏳ Attesa respawn: " .. bossEntry.Name .. "...", 0)
			task.wait(0.25)
		end
	end

	return true
end

local function CheckAndFightBoss(bossEntry)
	if not getgenv().AutoFarmActive or justRebirthed then return false end
	isCurrentlyAttacking = false

	local character = localPlayer.Character
	if not character or not character:FindFirstChildOfClass("Humanoid") or character.Humanoid.Health <= 0 then return false end

	local hrp = character:FindFirstChild("HumanoidRootPart")
	local playerData = ReplicatedStorage.Datas:FindFirstChild(tostring(localPlayer.UserId))
	if not playerData or not hrp then return false end

	local npcFolder = workspace:FindFirstChild("Others") and workspace.Others:FindFirstChild("NPCs")
	local bossNpc = (not bossEntry.NoQuest and npcFolder) and (npcFolder:FindFirstChild(bossEntry.Name) or npcFolder:FindFirstChild(bossEntry.Boss)) or nil
	local livingBoss = FindLivingBoss(bossEntry)

	if not bossEntry.NoQuest and not bossNpc and not livingBoss then return false end

	if bossEntry.NoQuest then
		local isKnownInMap = (livingBoss ~= nil)
			or (confirmedNoQuestBosses[bossEntry.Name] == true)
			or (lastActiveNoQuestBoss == bossEntry.Name)
			or (getgenv().ManualBoss == bossEntry.Name)

		if not isKnownInMap then return false end
		confirmedNoQuestBosses[bossEntry.Name] = true
		lastActiveNoQuestBoss = bossEntry.Name
	end

	if not EnsureFormAndKaioken() then return true end

	if bossNpc and bossNpc:FindFirstChild("HumanoidRootPart") then
		local questVal = playerData:WaitForChild("Quest")

		while questVal.Value ~= bossEntry.Name and questVal.Value ~= bossEntry.Boss do
			if not IsCurrentSession() or not getgenv().AutoFarmActive or justRebirthed then
				StopActiveTween()
				return true
			end
			if getgenv().ManualBoss and getgenv().ManualBoss ~= bossEntry.Name then
				StopActiveTween()
				return true
			end
			if NeedsFormOrKaiokenRightNow() then
				if not EnsureFormAndKaioken() then
					StopActiveTween()
					return true
				end
			end
			if not localPlayer.Character or not localPlayer.Character:FindFirstChildOfClass("Humanoid") or localPlayer.Character.Humanoid.Health <= 0 then
				return true
			end

			isCurrentlyAttacking = false
			currentLockedBoss = nil
			lastServerLockedBoss = nil
			SetStatus("✈️ Quest: " .. bossEntry.Name, 0)
			local npcCF = bossNpc.HumanoidRootPart.CFrame * CFrame.new(0, 0, -3)
			MoveToTarget(npcCF, true)

			if localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart") then
				if (localPlayer.Character.HumanoidRootPart.Position - npcCF.Position).Magnitude <= 12 then
					pcall(function() qActionRemote:InvokeServer(bossNpc) end)
				end
			end

			task.wait(0.2)
		end

		if questVal.Value == bossEntry.Name or questVal.Value == bossEntry.Boss then
			return WaitForBossToSpawnAndCompleteQuest(bossEntry, true, questVal)
		end
		return true
	else
		return WaitForBossToSpawnAndCompleteQuest(bossEntry, false, nil)
	end
end

