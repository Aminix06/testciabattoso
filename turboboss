task.spawn(function()
	repeat task.wait() until game:IsLoaded()

	local function IsPublicServer()
		if #Players:GetPlayers() > 1 then return false end
		local jobId = game.JobId
		local placeId = game.PlaceId
		local cursor = ""
		local pages = 0
		while pages < 8 do
			local url = "https://games.roblox.com/v1/games/" .. placeId .. "/servers/Public?limit=100&cursor=" .. cursor
			local requestFunc = (syn and syn.request) or (http and http.request) or http_request or request
			if not requestFunc then return false end
			local success, response = pcall(function() return requestFunc({Url = url, Method = "GET"}) end)
			if not success or not response or response.StatusCode ~= 200 then break end
			local ok, data = pcall(function() return HttpService:JSONDecode(response.Body) end)
			if not ok or not data or not data.data then break end
			for _, server in ipairs(data.data) do
				if server.id == jobId then return true end
			end
			cursor = data.nextPageCursor
			if not cursor or cursor == "" then break end
			pages += 1
			task.wait(0.15)
		end
		return false
	end

	if IsPublicServer() then
		localPlayer:Kick("SEI IN UN SERVER PUBBLICO! Kick di sicurezza attivato.")
	else
		local TPEvent = Events:WaitForChild("TP")
		local isEscaping = false

		local function FugaSullaTerra()
			if isEscaping then return end
			isEscaping = true
			warn("⚠️ Intruso rilevato! Fuga istantanea verso Earth...")
			StopActiveTween()
			pcall(function()
				if localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart") then
					localPlayer.Character.HumanoidRootPart.Anchored = true
				end
			end)
			pcall(function() TPEvent:InvokeServer("Earth") end)
			task.delay(5, function()
				localPlayer:Kick("⚠️ Il teletrasporto interno ha fallito. Disconnessione di emergenza.")
			end)
		end

		if #Players:GetPlayers() > 1 then FugaSullaTerra() end
		table.insert(connections, Players.PlayerAdded:Connect(function(player)
			if player.UserId ~= localPlayer.UserId then FugaSullaTerra() end
		end))
		task.spawn(function()
			while IsCurrentSession() and task.wait(1) do
				if #Players:GetPlayers() > 1 then FugaSullaTerra() end
			end
		end)
	end
end)

