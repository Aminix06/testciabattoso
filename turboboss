local function FormatStat(n)
	n = tonumber(n) or 0
	if n >= 1e24 then return string.format("%.0fSp", n / 1e24)
	elseif n >= 1e21 then return string.format("%.0fSx", n / 1e21)
	elseif n >= 1e18 then return string.format("%.1fQi", n / 1e18)
	elseif n >= 1e15 then return string.format("%.1fQd", n / 1e15)
	elseif n >= 1e12 then return string.format("%.1fT", n / 1e12)
	elseif n >= 1e9 then return string.format("%.0fB", n / 1e9)
	elseif n >= 1e6 then return string.format("%.0fM", n / 1e6)
	elseif n >= 1e3 then return string.format("%.0fk", n / 1e3)
	else return tostring(n) end
end

