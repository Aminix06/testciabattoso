					if playerData then
						if getgenv().ManualBoss then
							for _, bEntry in ipairs(BossList) do
								if bEntry.Name == getgenv().ManualBoss then
									local fought = CheckAndFightBoss(bEntry)
									if not fought and getgenv().AutoFarmActive then
										isCurrentlyAttacking = false
										SetStatus("⏳ Attesa: " .. bEntry.Name, 0)
									end
									break
								end
							end
						else
							local myDef = tonumber(playerData:FindFirstChild("Defense") and playerData.Defense.Value) or 0
							local questVal = playerData:FindFirstChild("Quest")
							local currentQuestName = questVal and questVal.Value or ""

							local activeQuestEntry = GetActiveQuestBossEntry(currentQuestName, myDef)
							local bestMapBoss = GetBestBossInMap(myDef)
							local targetBoss = nil

							if activeQuestEntry and bestMapBoss then
								if bestMapBoss.MinDef > activeQuestEntry.MinDef then
									targetBoss = bestMapBoss
								else
									targetBoss = activeQuestEntry
								end
							elseif activeQuestEntry then
								targetBoss = activeQuestEntry
							elseif bestMapBoss then
								targetBoss = bestMapBoss
							end

							if targetBoss then
								local fought = CheckAndFightBoss(targetBoss)
								if not fought and getgenv().AutoFarmActive then
									isCurrentlyAttacking = false
									SetStatus("⏳ Attesa: " .. targetBoss.Name, 0)
								end
							else
								if getgenv().AutoFarmActive then
									isCurrentlyAttacking = false
									SetStatus("🔍 Cerco Boss (Def: " .. FormatStat(myDef) .. ")...", 0)
								end
							end
						end
					end
				end
			end
		end
		task.wait(0.25)
	end
end)
