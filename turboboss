	local stroke1 = Instance.new("UIStroke", outerArc)
	stroke1.Color = accentCol
	stroke1.Thickness = 1.8
	stroke1.Transparency = 0.35

	local innerArc = Instance.new("Frame", arcClip)
	innerArc.Size = UDim2.new(0, 15, 0, 15)
	innerArc.Position = UDim2.new(0, -7.5, 0, -7.5)
	innerArc.BackgroundTransparency = 1
	Instance.new("UICorner", innerArc).CornerRadius = UDim.new(0, 8)
	local stroke2 = Instance.new("UIStroke", innerArc)
	stroke2.Color = accentCol
	stroke2.Thickness = 1.8
	stroke2.Transparency = 0.35

	gripHitbox.MouseEnter:Connect(function()
		TweenService:Create(stroke1, TweenInfo.new(0.15), {Transparency = 0, Thickness = 2.3}):Play()
		TweenService:Create(stroke2, TweenInfo.new(0.15), {Transparency = 0, Thickness = 2.3}):Play()
	end)
	gripHitbox.MouseLeave:Connect(function()
		TweenService:Create(stroke1, TweenInfo.new(0.15), {Transparency = 0.35, Thickness = 1.8}):Play()
		TweenService:Create(stroke2, TweenInfo.new(0.15), {Transparency = 0.35, Thickness = 1.8}):Play()
	end)

	local resizing = false
	local startPos = Vector2.zero
	local startScale = initialScale

	gripHitbox.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			resizing = true
			startPos = Vector2.new(input.Position.X, input.Position.Y)
			startScale = uiScale.Scale
		end
	end)
	table.insert(connections, UserInputService.InputEnded:Connect(function(input)
		if resizing and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
			resizing = false
			SaveConfig()
		end
	end))
	table.insert(connections, UserInputService.InputChanged:Connect(function(input)
		if resizing and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local dx = input.Position.X - startPos.X
			local dy = input.Position.Y - startPos.Y
			local combinedDelta = (dx + dy) * 0.5
			local newScale = math.clamp(startScale + (combinedDelta / refSize), 0.65, 1.55)
			TweenService:Create(uiScale, TweenInfo.new(0.05, Enum.EasingStyle.Linear), {Scale = newScale}):Play()
			if onScaleChanged then onScaleChanged(newScale) end
		end
	end))

	return uiScale, function(vis)
		gripHitbox.Visible = vis
		arcClip.Visible = vis
	end
end

