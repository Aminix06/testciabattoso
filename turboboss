local activeTween = nil
local currentLockedBoss = nil
local behindDistance = -5
local connections = {}

local function StopActiveTween()
	if activeTween then
		pcall(function() activeTween:Cancel() end)
		activeTween = nil
	end
end

local function UpdateFloatState()
	local char = localPlayer.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not root then return end

	for _, child in ipairs(root:GetChildren()) do
		if child.Name == "FloatAttachment" or child.Name == "FloatVelocity" then
			child:Destroy()
		end
	end

	if hum then
		hum.AutoRotate = not getgenv().AutoFarmActive
	end

	if getgenv().AutoFarmActive then
		local att = Instance.new("Attachment", root)
		att.Name = "FloatAttachment"
		local lv = Instance.new("LinearVelocity", root)
		lv.Name = "FloatVelocity"
		lv.Attachment0 = att
		lv.MaxForce = math.huge
		lv.VectorVelocity = Vector3.zero
		lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
		lv.ForceLimitMode = Enum.ForceLimitMode.PerAxis
		lv.MaxAxesForce = Vector3.new(0, math.huge, 0)
	end
end

table.insert(connections, RunService.Stepped:Connect(function()
	if not getgenv().AutoFarmActive then return end
	local char = localPlayer.Character
	if char then
		for _, part in ipairs(char:GetDescendants()) do
			if part:IsA("BasePart") and part.CanCollide then
				part.CanCollide = false
			end
		end
	end
end))

table.insert(connections, RunService.RenderStepped:Connect(function()
	if not getgenv().AutoFarmActive or not currentLockedBoss then return end

	local char = localPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local eHrp = currentLockedBoss:FindFirstChild("HumanoidRootPart")
	local eHum = currentLockedBoss:FindFirstChildOfClass("Humanoid")

	if not hrp or not hum or hum.Health <= 0 or not eHrp or not eHum or eHum.Health <= 0 then
		return
	end

	local dist = (hrp.Position - eHrp.Position).Magnitude
	if dist <= 25 then
		StopActiveTween()
		hum.AutoRotate = false
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero

		local behindPos = eHrp.Position + (eHrp.CFrame.LookVector * behindDistance)
		local targetCF = CFrame.new(behindPos, eHrp.Position)

		hrp.CFrame = hrp.CFrame:Lerp(targetCF, 0.88)
		camera.CFrame = CFrame.new(camera.CFrame.Position, eHrp.Position)
	end
end))

local function MoveToTarget(targetCFrame, waitForCompletion)
	if not getgenv().AutoFarmActive or not IsCurrentSession() then
		StopActiveTween()
		return
	end
	if waitForCompletion == nil then waitForCompletion = true end

	local char = localPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum or hum.Health <= 0 then return end

	local currentSpeed = math.clamp(tonumber(getgenv().TweenSpeed) or 300, 10, MAX_TWEEN_SPEED)
	local distance = (hrp.Position - targetCFrame.Position).Magnitude
	local duration = math.max(distance / currentSpeed, 0.04)

	hrp.AssemblyLinearVelocity = Vector3.zero
	hrp.AssemblyAngularVelocity = Vector3.zero

	StopActiveTween()
	activeTween = TweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
	activeTween:Play()

	if not waitForCompletion then return end

	local startClock = os.clock()
	while activeTween and activeTween.PlaybackState == Enum.PlaybackState.Playing do
		if not IsCurrentSession() or not getgenv().AutoFarmActive then
			StopActiveTween()
			break
		end
		if not localPlayer.Character or not localPlayer.Character:FindFirstChildOfClass("Humanoid") or localPlayer.Character.Humanoid.Health <= 0 then
			StopActiveTween()
			break
		end

		local updatedSpeed = math.clamp(tonumber(getgenv().TweenSpeed) or 300, 10, MAX_TWEEN_SPEED)
		if math.abs(updatedSpeed - currentSpeed) > 5 then
			currentSpeed = updatedSpeed
			local remDist = (hrp.Position - targetCFrame.Position).Magnitude
			duration = math.max(remDist / currentSpeed, 0.04)
			StopActiveTween()
			activeTween = TweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
			activeTween:Play()
			startClock = os.clock()
		end

		if (hrp.Position - targetCFrame.Position).Magnitude <= 4 or (os.clock() - startClock) > (duration + 0.5) then
			break
		end
		task.wait(0.03)
	end
end

