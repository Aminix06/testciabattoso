local function WaitForTransformation(bossMinDef)
	if not getgenv().AutoFarmActive then return false end
	local char = localPlayer.Character
	if not char or not char:FindFirstChildOfClass("Humanoid") or char.Humanoid.Health <= 0 then return false end

	local folderData = ReplicatedStorage:FindFirstChild("Datas") and ReplicatedStorage.Datas:FindFirstChild(tostring(localPlayer.UserId))
	local status = localPlayer:FindFirstChild("Status") or char:FindFirstChild("Status")
	if not folderData or not status then return false end

	local defVal = tonumber(folderData:FindFirstChild("Defense") and folderData.Defense.Value) or 0
	local rebVal = tonumber(folderData:FindFirstChild("Rebirth") and folderData.Rebirth.Value) or 0
	local actual = status:FindFirstChild("Transformation")
	if not actual then return false end

	local targetForm = nil
	for _, f in ipairs(FormProgression) do
		if defVal >= f.MinDef and rebVal >= f.MinReb then
			targetForm = f.Name
			break
		end
	end

	if not targetForm then
		if (bossMinDef or 0) <= NO_FORM_MAX_DEF then
			return true
		else
			SetStatus("⚠️ Oltre 10T serve la Forma (1T+500k Reb o 6Qa)!")
			return false
		end
	end

	local timeout = 16
	while actual.Value ~= targetForm and timeout > 0 and getgenv().AutoFarmActive and IsCurrentSession() do
		if not localPlayer.Character or localPlayer.Character:FindFirstChildOfClass("Humanoid").Health <= 0 then return false end
		SetStatus("⚡ Attivazione " .. targetForm .. "...")
		task.wait(0.5)
		timeout -= 1
	end

	if (bossMinDef or 0) <= NO_FORM_MAX_DEF then return true end
	return actual.Value == targetForm
end

