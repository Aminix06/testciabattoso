-- 🎯 FUNZIONE LOCK-ON LATO SERVER ("locky") PER ROSE MASSACRE & TIMESKIP BREAKER
local function EnsureServerLockOn(bossModel)
	if not bossModel then return end
	local status = GetLiveStatus()
	local lockedObj = status and (status:FindFirstChild("LockedOn") or status:FindFirstChild("LockOn") or status:FindFirstChild("Target"))

	if lockedObj then
		if lockedObj.Value ~= bossModel then
			pcall(function() lockyRemote:FireServer(bossModel) end)
			lastServerLockedBoss = bossModel
		end
	elseif lastServerLockedBoss ~= bossModel then
		pcall(function() lockyRemote:FireServer(bossModel) end)
		lastServerLockedBoss = bossModel
	end
end

