local function FindLivingBoss(bossEntry)
	local character = localPlayer.Character
	if not character or not character:FindFirstChildOfClass("Humanoid") or character.Humanoid.Health <= 0 then return nil end
	if not workspace:FindFirstChild("Living") then return nil end

	for _, obj in pairs(workspace.Living:GetChildren()) do
		if obj.Name == bossEntry.Boss or obj.Name == bossEntry.Name then
			local bossHumanoid = obj:FindFirstChildOfClass("Humanoid")
			local bossHRP = obj:FindFirstChild("HumanoidRootPart")
			if bossHumanoid and bossHRP and bossHumanoid.Health > 0 then
				return obj
			end
		end
	end
	return nil
end

local function DoFullAttack()
	pcall(function()
		punchRemote:FireServer("Blacknwhite27", 1, false)
		punchRemote:FireServer("Blacknwhite27", 1)

		for _, skill in ipairs(SkillRequirements) do
			if equippedSkills[skill.Name] then
				coroutine.wrap(function()
					pcall(function()
						skillRemote:InvokeServer(skill.Name, "Blacknwhite27")
					end)
				end)()
			end
		end
	end)
end

local function TweenAndFight(bossEntry, hasQuestNpc)
	local playerData = ReplicatedStorage.Datas:FindFirstChild(tostring(localPlayer.UserId))
	local questVal = playerData and playerData:FindFirstChild("Quest")

	CheckAndEquipSkills(false)

	while IsCurrentSession() and getgenv().AutoFarmActive do
		if getgenv().ManualBoss and getgenv().ManualBoss ~= bossEntry.Name then break end

		if hasQuestNpc and questVal then
			if questVal.Value ~= bossEntry.Name and questVal.Value ~= bossEntry.Boss then
				break
			end
		end

		local currentBoss = FindLivingBoss(bossEntry)
		if not currentBoss then break end

		local bossHRP = currentBoss:FindFirstChild("HumanoidRootPart")
		local bossHum = currentBoss:FindFirstChildOfClass("Humanoid")
		local character = localPlayer.Character
		local hrp = character and character:FindFirstChild("HumanoidRootPart")
		if not bossHRP or not bossHum or not hrp then break end

		currentLockedBoss = currentBoss
		local distToBoss = (hrp.Position - bossHRP.Position).Magnitude

		if distToBoss > 25 then
			isCurrentlyAttacking = false
			SetStatus("✈️ Tween verso Boss: " .. bossEntry.Name)
			local behindOffset = bossHRP.CFrame.LookVector * behindDistance
			local targetCF = CFrame.new(bossHRP.Position + behindOffset, bossHRP.Position)
			pcall(function() MoveToTarget(targetCF, false) end)
		else
			local wsChar = workspace:FindFirstChild("Living") and workspace.Living:FindFirstChild(localPlayer.Name)
			local kiObj = wsChar and wsChar:FindFirstChild("Stats") and wsChar.Stats:FindFirstChild("Ki")
			if kiObj and (tonumber(kiObj.Value) or 100) < 10 then
				isCurrentlyAttacking = false
				SetStatus("⚡ Ricarica rapida Ki...")
				task.wait(0.35)
			else
				isCurrentlyAttacking = true
				local hpPct = math.floor((bossHum.Health / math.max(bossHum.MaxHealth, 1)) * 100)
				SetStatus(string.format("⚔️ %s [HP: %d%%]", bossEntry.Name, hpPct))
				DoFullAttack()
			end
		end

		task.wait(0.1)
	end

	isCurrentlyAttacking = false
	currentLockedBoss = nil
	StopActiveTween()
	pcall(function()
		camera.CameraType = Enum.CameraType.Custom
		if localPlayer.Character and localPlayer.Character:FindFirstChildOfClass("Humanoid") then
			localPlayer.Character:FindFirstChildOfClass("Humanoid").AutoRotate = true
			camera.CameraSubject = localPlayer.Character:FindFirstChildOfClass("Humanoid")
		end
	end)
end

local function WaitForBossToSpawn(bossEntry, timeLimit, hasQuestNpc)
	local startTime = os.time()
	local bossReady = false
	isCurrentlyAttacking = false

	repeat
		if not IsCurrentSession() or not getgenv().AutoFarmActive then return false end
		if getgenv().ManualBoss and getgenv().ManualBoss ~= bossEntry.Name then return false end
		local char = localPlayer.Character
		if not char or not char:FindFirstChildOfClass("Humanoid") or char.Humanoid.Health <= 0 then return false end

		task.wait(0.2)
		local currentBoss = FindLivingBoss(bossEntry)
		bossReady = (currentBoss ~= nil)
	until bossReady or os.time() - startTime > timeLimit

	if bossReady and getgenv().AutoFarmActive then
		task.wait(0.1)
		TweenAndFight(bossEntry, hasQuestNpc)
		return true
	end
	return false
end

local function CheckAndFightBoss(bossEntry)
	if not getgenv().AutoFarmActive then return false end
	isCurrentlyAttacking = false

	local character = localPlayer.Character
	if not character or not character:FindFirstChildOfClass("Humanoid") or character.Humanoid.Health <= 0 then return false end

	local hrp = character:FindFirstChild("HumanoidRootPart")
	local playerData = ReplicatedStorage.Datas:FindFirstChild(tostring(localPlayer.UserId))
	if not playerData or not hrp then return false end

	local npcFolder = workspace:FindFirstChild("Others") and workspace.Others:FindFirstChild("NPCs")
	local bossNpc = (not bossEntry.NoQuest and npcFolder) and (npcFolder:FindFirstChild(bossEntry.Name) or npcFolder:FindFirstChild(bossEntry.Boss)) or nil

	if not bossEntry.NoQuest and not bossNpc and not FindLivingBoss(bossEntry) then
		return false
	end
	if bossEntry.NoQuest and not FindLivingBoss(bossEntry) then
		return false
	end

	if not WaitForTransformation(bossEntry.MinDef) then return false end

	if bossNpc and bossNpc:FindFirstChild("HumanoidRootPart") then
		local questVal = playerData:WaitForChild("Quest")
		while questVal.Value ~= bossEntry.Name and questVal.Value ~= bossEntry.Boss do
			if not IsCurrentSession() or not getgenv().AutoFarmActive then
				StopActiveTween()
				return false
			end
			if getgenv().ManualBoss and getgenv().ManualBoss ~= bossEntry.Name then
				StopActiveTween()
				return false
			end
			if not localPlayer.Character or localPlayer.Character:FindFirstChildOfClass("Humanoid").Health <= 0 then return false end

			isCurrentlyAttacking = false
			currentLockedBoss = nil
			SetStatus("✈️ Tween verso Quest: " .. bossEntry.Name)
			local npcCF = bossNpc.HumanoidRootPart.CFrame * CFrame.new(0, 0, -3)
			MoveToTarget(npcCF, true)

			if (localPlayer.Character.HumanoidRootPart.Position - npcCF.Position).Magnitude <= 12 then
				pcall(function()
					Events:WaitForChild("Qaction"):InvokeServer(bossNpc)
				end)
			end

			task.wait(0.2)
		end

		if questVal.Value == bossEntry.Name or questVal.Value == bossEntry.Boss then
			return WaitForBossToSpawn(bossEntry, 5, true)
		end
	else
		return WaitForBossToSpawn(bossEntry, 5, false)
	end
	return false
end

