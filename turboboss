task.spawn(function()
	while IsCurrentSession() do
		local ok, res = pcall(function() return previewRemote:InvokeServer() end)
		if ok then
			local previewNum = ParseRebirthInt(res)
			currentPreviewRebs = previewNum
			if RebPreviewLbl and RebPreviewLbl.Parent then
				RebPreviewLbl.Text = "Prev: +" .. FormatReb(previewNum)
			end

			local targetReb = tonumber(getgenv().TargetRebAmount) or 1
			if getgenv().AutoRebActive and previewNum >= targetReb and targetReb > 0 then
				isCurrentlyAttacking = false
				isTransforming = false
				currentLockedBoss = nil
				lastServerLockedBoss = nil
				justRebirthed = true
				StopActiveTween()

				SetStatus("👑 MULTIREB (+" .. FormatReb(previewNum) .. " Reb)!", 1)
				pcall(function() multirebRemote:InvokeServer() end)

