-- 🔥 CONTROLLO FORMA RAPIDO (SKIPPA OMNI SSJ PER EVITARE KICK SE NON È GIÀ SELEZIONATA)
local function GetBestAvailableCandidate(defVal, rebVal)
	local status = GetLiveStatus()
	local selectedVal = status and status:FindFirstChild("SelectedTransformation") and status.SelectedTransformation.Value or ""
	local actualVal = status and status:FindFirstChild("Transformation") and status.Transformation.Value or ""

	for _, f in ipairs(FormProgression) do
		if defVal >= f.MinDef and rebVal >= (f.MinReb or 0) and not rejectedForms[f.Name] then
			if f.OnlyIfAlreadySelected then
				-- Usa Omni SSJ solo se l'hai già selezionata tu nel menu del gioco (non invia mai equipskill!)
				if selectedVal == f.Name or actualVal == f.Name then
					return f.Name
				end
			else
				return f.Name
			end
		end
	end
	return nil
end

local function NeedsFormOrKaiokenRightNow()
	local folderData = ReplicatedStorage:FindFirstChild("Datas") and ReplicatedStorage.Datas:FindFirstChild(tostring(localPlayer.UserId))
	local status = GetLiveStatus()
	if not folderData or not status then return false end

	local defVal = tonumber(folderData:FindFirstChild("Defense") and folderData.Defense.Value) or 0
	local rebVal = tonumber(folderData:FindFirstChild("Rebirth") and folderData.Rebirth.Value) or 0
	local actual = status:FindFirstChild("Transformation")
	if not actual then return false end

	if defVal <= NO_FORM_MAX_DEF and not (defVal >= 1e12 and rebVal >= 500000) then
		return false
	end

	local bestCandidate = GetBestAvailableCandidate(defVal, rebVal)
	if bestCandidate and actual.Value ~= bestCandidate then
		return true
	end
	if not IsKaiokenCurrentlyActive() then
		return true
	end
	return false
end

local function EnsureFormAndKaioken()
	if not getgenv().AutoFarmActive or justRebirthed then return false end
	local char = localPlayer.Character
	if not char or not char:FindFirstChildOfClass("Humanoid") or char.Humanoid.Health <= 0 then return false end

	local folderData = ReplicatedStorage:FindFirstChild("Datas") and ReplicatedStorage.Datas:FindFirstChild(tostring(localPlayer.UserId))
	local status = GetLiveStatus()
	if not folderData or not status then return false end

	local defVal = tonumber(folderData:FindFirstChild("Defense") and folderData.Defense.Value) or 0
	local rebVal = tonumber(folderData:FindFirstChild("Rebirth") and folderData.Rebirth.Value) or 0
	local selected = status:FindFirstChild("SelectedTransformation")
	local actual = status:FindFirstChild("Transformation")
	if not selected or not actual then return false end

	if defVal <= NO_FORM_MAX_DEF and not (defVal >= 1e12 and rebVal >= 500000) then
		return true
	end

	local targetForm = GetBestAvailableCandidate(defVal, rebVal)

	if targetForm and actual.Value ~= targetForm then
		isCurrentlyAttacking = false
		isTransforming = true
		currentLockedBoss = nil
		StopActiveTween()

		while getgenv().AutoFarmActive and IsCurrentSession() and not justRebirthed do
			if not localPlayer.Character or not localPlayer.Character:FindFirstChildOfClass("Humanoid") or localPlayer.Character.Humanoid.Health <= 0 then
				isTransforming = false
				return false
			end

			defVal = tonumber(folderData:FindFirstChild("Defense") and folderData.Defense.Value) or 0
			rebVal = tonumber(folderData:FindFirstChild("Rebirth") and folderData.Rebirth.Value) or 0
			targetForm = GetBestAvailableCandidate(defVal, rebVal)

			if not targetForm then break end
			if actual.Value == targetForm then
				lastTransformClock = os.clock()
				break
			end

			SetStatus("⚡ Equip Forma: " .. targetForm .. "...", 0.3)

			if selected.Value ~= targetForm then
				for _ = 1, 2 do
					pcall(function() equipRemote:InvokeServer(targetForm) end)
					if selected.Value == targetForm then break end
					task.wait(0.12)
				end
			end

			if selected.Value == targetForm then
				local wsChar = workspace:FindFirstChild("Living") and workspace.Living:FindFirstChild(localPlayer.Name)
				local kiObj = wsChar and wsChar:FindFirstChild("Stats") and wsChar.Stats:FindFirstChild("Ki")
				if kiObj and (tonumber(kiObj.Value) or 100) < 15 then
					pcall(function() chaRemote:InvokeServer("Blacknwhite27") end)
					task.wait(0.08)
				end

				SetStatus("⚡ Attivazione: " .. targetForm .. "...", 0.5)
				pcall(function() transformRemote:InvokeServer() end)

				local checkWait = 0
				while actual.Value ~= targetForm and checkWait < 8 and getgenv().AutoFarmActive and not justRebirthed do
					task.wait(0.12)
					checkWait += 1
				end

				if actual.Value == targetForm then
					lastTransformClock = os.clock()
					break
				else
					rejectedForms[targetForm] = true
				end
			else
				rejectedForms[targetForm] = true
			end
		end

		isTransforming = false
		if targetForm and actual.Value ~= targetForm then
			return false
		end
	end

	if not IsKaiokenCurrentlyActive() then
		isCurrentlyAttacking = false
		isTransforming = true
		currentLockedBoss = nil
		StopActiveTween()

		local waitDuration = tonumber(getgenv().KaiokenWaitTime) or 1
		if lastTransformClock > 0 then
			while not IsKaiokenCurrentlyActive() and (os.clock() - lastTransformClock) < waitDuration do
				if not IsCurrentSession() or not getgenv().AutoFarmActive or justRebirthed then
					isTransforming = false
					return false
				end
				if not localPlayer.Character or not localPlayer.Character:FindFirstChildOfClass("Humanoid") or localPlayer.Character.Humanoid.Health <= 0 then
					isTransforming = false
					return false
				end
				if targetForm and actual.Value ~= targetForm then
					isTransforming = false
					return false
				end

				local elapsedWait = os.clock() - lastTransformClock
				local remaining = math.max(0, waitDuration - elapsedWait)
				local ratio = math.clamp(elapsedWait / math.max(waitDuration, 0.1), 0, 1)
				SetStatus(string.format("🔥 Attesa Kaioken: %.1fs...", remaining), ratio)
				task.wait(0.08)
			end
		end

		local attempts = 0
		while not IsKaiokenCurrentlyActive() and attempts < 5 and getgenv().AutoFarmActive and IsCurrentSession() and not justRebirthed do
			if not localPlayer.Character or not localPlayer.Character:FindFirstChildOfClass("Humanoid") or localPlayer.Character.Humanoid.Health <= 0 then
				isTransforming = false
				return false
			end
			if targetForm and actual.Value ~= targetForm then
				isTransforming = false
				return false
			end

			SetStatus("🔥 Attivazione Kaioken (schtah)...", 1)
			pcall(function() kaiokenRemote:InvokeServer() end)

			local checkKK = 0
			while not IsKaiokenCurrentlyActive() and checkKK < 5 do
				task.wait(0.12)
				checkKK += 1
			end
			attempts += 1
		end

		isTransforming = false
		CheckAndEquipSkills(true)
	end

	return ((not targetForm or actual.Value == targetForm) and IsKaiokenCurrentlyActive())
end

