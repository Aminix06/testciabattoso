-- 🔢 GESTIONE REBIRTH E FORMATTAZIONE STATISTICHE
local SuffixMultipliers = {
	k = 1e3, m = 1e6, b = 1e9, t = 1e12,
	qd = 1e15, qa = 1e15, qi = 1e18, sx = 1e21, sp = 1e24
}

local function ParseRebirthInt(res)
	if type(res) == "number" then
		return math.floor(res)
	elseif type(res) == "string" then
		local s = string.lower(string.gsub(res, "%s+", ""))
		local numPart, suffix = string.match(s, "^[%+]?([%d%.,]+)([a-z]+)$")
		if numPart and suffix and SuffixMultipliers[suffix] then
			numPart = string.gsub(numPart, ",", ".")
			local n = tonumber(numPart)
			if n then return math.floor(n * SuffixMultipliers[suffix] + 0.5) end
		end
		local digitsOnly = string.gsub(s, "[%.,]", "")
		return tonumber(string.match(digitsOnly, "%d+")) or 0
	elseif type(res) == "table" then
		for _, v in pairs(res) do
			local parsed = ParseRebirthInt(v)
			if parsed > 0 then return parsed end
		end
	end
	return 0
end

local function FormatReb(n)
	n = math.floor(tonumber(n) or 0)
	local function FormatUnit(val, suffix)
		if val < 10 then
			return (string.format("%.2f", val):gsub("%.", ",")) .. suffix
		else
			return tostring(math.floor(val)) .. suffix
		end
	end
	if n >= 1e18 then return FormatUnit(n / 1e18, "Qi")
	elseif n >= 1e15 then return FormatUnit(n / 1e15, "Qd")
	elseif n >= 1e12 then return FormatUnit(n / 1e12, "T")
	elseif n >= 1e9 then return FormatUnit(n / 1e9, "B")
	elseif n >= 1e6 then return FormatUnit(n / 1e6, "M")
	elseif n >= 100000 then return tostring(math.floor(n / 1e3)) .. "k"
	else return tostring(n) end
end

local function FormatStat(n)
	n = tonumber(n) or 0
	if n >= 1e24 then return string.format("%.2fSp", n / 1e24)
	elseif n >= 1e21 then return string.format("%.2fSx", n / 1e21)
	elseif n >= 1e18 then return string.format("%.2fQi", n / 1e18)
	elseif n >= 1e15 then return string.format("%.2fQd", n / 1e15)
	elseif n >= 1e12 then return string.format("%.2fT", n / 1e12)
	elseif n >= 1e9 then return string.format("%.2fB", n / 1e9)
	elseif n >= 1e6 then return string.format("%.2fM", n / 1e6)
	elseif n >= 1e3 then return string.format("%.1fk", n / 1e3)
	else return tostring(math.floor(n)) end
end

