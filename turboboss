local activeTween = nil
local currentLockedBoss = nil
local behindDistance = -5
local connections = {}

local function StopActiveTween()
	if activeTween then
		pcall(function() activeTween:Cancel() end)
		activeTween = nil
	end
end

local function UpdateFloatState()
	local char = localPlayer.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not root then return end

	for _, child in ipairs(root:GetChildren()) do
		if child.Name == "FloatAttachment" or child.Name == "FloatVelocity" then
			child:Destroy()
		end
	end

	if hum then
		hum.AutoRotate = not getgenv().AutoFarmActive
	end

	if getgenv().AutoFarmActive then
		local att = Instance.new("Attachment", root)
		att.Name = "FloatAttachment"
		local lv = Instance.new("LinearVelocity", root)
		lv.Name = "FloatVelocity"
		lv.Attachment0 = att
		lv.MaxForce = math.huge
		lv.VectorVelocity = Vector3.zero
		lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
		lv.ForceLimitMode = Enum.ForceLimitMode.PerAxis
		lv.MaxAxesForce = Vector3.new(0, math.huge, 0)
	end
end

table.insert(connections, RunService.Stepped:Connect(function()
	if not getgenv().AutoFarmActive then return end
	local char = localPlayer.Character
	if char then
		for _, part in ipairs(char:GetDescendants()) do
			if part:IsA("BasePart") and part.CanCollide then
				part.CanCollide = false
			end
		end
	end
end))

table.insert(connections, RunService.RenderStepped:Connect(function()
