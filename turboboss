local function MoveToTarget(targetCFrame, waitForCompletion)
	if not getgenv().AutoFarmActive or not IsCurrentSession() then
		StopActiveTween()
		return
	end
	if waitForCompletion == nil then waitForCompletion = true end

	local char = localPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum or hum.Health <= 0 then return end

	local currentSpeed = math.clamp(tonumber(getgenv().TweenSpeed) or 300, 10, MAX_TWEEN_SPEED)
	local distance = (hrp.Position - targetCFrame.Position).Magnitude
	local duration = math.max(distance / currentSpeed, 0.04)

	hrp.AssemblyLinearVelocity = Vector3.zero
	hrp.AssemblyAngularVelocity = Vector3.zero

	StopActiveTween()
	activeTween = TweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
	activeTween:Play()

	if not waitForCompletion then return end

	local startClock = os.clock()
	while activeTween and activeTween.PlaybackState == Enum.PlaybackState.Playing do
		if not IsCurrentSession() or not getgenv().AutoFarmActive or justRebirthed then
			StopActiveTween()
			break
		end
		if not localPlayer.Character or not localPlayer.Character:FindFirstChildOfClass("Humanoid") or localPlayer.Character.Humanoid.Health <= 0 then
			StopActiveTween()
			break
		end

		local updatedSpeed = math.clamp(tonumber(getgenv().TweenSpeed) or 300, 10, MAX_TWEEN_SPEED)
		if math.abs(updatedSpeed - currentSpeed) > 5 then
			currentSpeed = updatedSpeed
			local remDist = (hrp.Position - targetCFrame.Position).Magnitude
			duration = math.max(remDist / currentSpeed, 0.04)
			StopActiveTween()
			activeTween = TweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
			activeTween:Play()
			startClock = os.clock()
		end

		if (hrp.Position - targetCFrame.Position).Magnitude <= 4 or (os.clock() - startClock) > (duration + 0.5) then
			break
		end
		task.wait(0.03)
	end
end

local function MakeDraggable(dragHandle, targetFrame)
	local dragging, dragStart, startPos
	dragHandle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = targetFrame.Position
		end
	end)
	table.insert(connections, UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end))
	table.insert(connections, UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			targetFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
		end
	end))
end

