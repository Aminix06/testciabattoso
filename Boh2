-- Funzione che mette in pausa il farm finché il personaggio non ha attivato la trasformazione
local function WaitForTransformation()
    local char = localPlayer.Character
    if not char or not char:FindFirstChild("Humanoid") or char.Humanoid.Health <= 0 then return end

    local status = localPlayer:FindFirstChild("Status") or char:FindFirstChild("Status")

    if status then
        local selected = status:FindFirstChild("SelectedTransformation")
        local actual = status:FindFirstChild("Transformation")

        if selected and actual then
            -- Mettiamo un timer massimo di 8 secondi, così se qualcosa va storto non si blocca per sempre
            local timeout = 16
            -- Aspetta che la trasformazione attiva (actual) sia uguale a quella scelta dallo script (selected)
            -- e che non sia "Base" (non trasformato)
            while actual.Value ~= selected.Value and actual.Value == "Base" and timeout > 0 do
                if not localPlayer.Character or localPlayer.Character:FindFirstChild("Humanoid").Health <= 0 then return end
                task.wait(0.5)
                timeout = timeout - 1
            end
            task.wait(0.5) -- Piccola pausa extra per far finire l'animazione dell'aura
        end
    end
end

