local function getValidBoss(bossData)
    local character = localPlayer.Character
    if not character or not character:FindFirstChild("Humanoid") or character.Humanoid.Health <= 0 then return nil end

    for _, obj in pairs(workspace.Living:GetChildren()) do
        -- Adesso cerca SOLO chi si chiama in modo identico (es. "X Fighter" esatto, senza lettere o numeri extra)
        if obj.Name == bossData.BossName then
            local bossHumanoid = obj:FindFirstChildOfClass("Humanoid")
            local bossHRP = obj:FindFirstChild("HumanoidRootPart")

            if bossHumanoid and bossHRP and bossHumanoid.Health > 0 then
                return obj
            end
        end
    end
    return nil
end

local function MoveAndFight(bossData, toggleName)
    local camera = workspace.CurrentCamera
    local playerData = ReplicatedStorage.Datas:FindFirstChild(tostring(localPlayer.UserId))
    local questVal = playerData and playerData:FindFirstChild("Quest")

    while true do
        if not getgenv().BossTargets[toggleName] then break end

        -- FIX IMPORTANTE: Se è un boss da quest, e hai completato la quest, FERMATI SUBITO!
        if bossData.QuestNPC and questVal then
            if questVal.Value ~= bossData.QuestNPC and questVal.Value ~= bossData.BossName then
                -- Esci dal combattimento per tornare a prendere la quest
                break
            end
        end

        local currentBoss = getValidBoss(bossData)
        if not currentBoss then break end -- Se non ci sono boss vivi, esci

        local bossHRP = currentBoss.HumanoidRootPart

        pcall(function()
            camera.CFrame = CFrame.lookAt(camera.CFrame.Position, bossHRP.Position)

            local behindOffset = bossHRP.CFrame.LookVector * bossData.Distance
            local behindPosition = bossHRP.Position + behindOffset
            local targetCFrame = CFrame.lookAt(behindPosition, bossHRP.Position)

            TweenCharacterTo(targetCFrame, MovementConfig.Speed)
        end)

        pcall(function()
            local Events = ReplicatedStorage:WaitForChild("Package"):WaitForChild("Events")
            local letsplayagame = Events:WaitForChild("FaFa")

            Events.p:FireServer("Blacknwhite27", 1)
            coroutine.wrap(function() letsplayagame:InvokeServer("Meteor Crash", "Blacknwhite27") end)()
            coroutine.wrap(function() letsplayagame:InvokeServer("Wolf Fang Fist", "Blacknwhite27") end)()
            coroutine.wrap(function() letsplayagame:InvokeServer("Mach Kick", "Blacknwhite27") end)()
            coroutine.wrap(function() letsplayagame:InvokeServer("God Slicer", "Blacknwhite27") end)()
            coroutine.wrap(function() letsplayagame:InvokeServer("Super Dragon Fist", "Blacknwhite27") end)()
        end)

        task.wait(0.1)
    end

    pcall(function()
        camera.CameraType = Enum.CameraType.Custom
        camera.CameraSubject = localPlayer.Character.Humanoid
    end)
end

local function WaitForBossToSpawn(bossData, timeLimit, toggleName)
    local startTime = os.time()
    local bossReady = false

    repeat
        local char = localPlayer.Character
        if not char or not char:FindFirstChild("Humanoid") or char.Humanoid.Health <= 0 then return end
        if not getgenv().BossTargets[toggleName] then return end

        task.wait(0.2)
        local currentBoss = getValidBoss(bossData)
        bossReady = (currentBoss ~= nil)
    until bossReady or os.time() - startTime > timeLimit

    if bossReady then
        task.wait(0.2)
        MoveAndFight(bossData, toggleName)
    end
end

local function CheckAndFightBoss(bossName)
    local bossData = BossConfig[bossName]
    if not bossData then return end

    WaitForTransformation()

    local character = localPlayer.Character
    if not character or not character:FindFirstChild("Humanoid") or character.Humanoid.Health <= 0 then return end

    local hrp = character:FindFirstChild("HumanoidRootPart")
    local playerData = ReplicatedStorage.Datas:FindFirstChild(tostring(localPlayer.UserId))
    if not playerData or not hrp then return end

    if bossData.QuestNPC then
        local questVal = playerData:WaitForChild("Quest")
        local bossNpc = workspace.Others.NPCs:FindFirstChild(bossData.QuestNPC)
        local expectedQuestName = bossData.QuestNPC

        -- PRENDE LA QUEST SOLO SE NON CE L'HA
        if bossNpc and bossNpc:FindFirstChild("HumanoidRootPart") then
            while questVal.Value ~= expectedQuestName and questVal.Value ~= bossData.BossName do
                if not getgenv().BossTargets[bossName] then return end
                if not localPlayer.Character or localPlayer.Character:FindFirstChild("Humanoid").Health <= 0 then return end

                local npcRoot = bossNpc:FindFirstChild("HumanoidRootPart")
                if not npcRoot then
                    break
                end

                local questPosition = npcRoot.CFrame * CFrame.new(0, 0, -3)
                TweenCharacterTo(questPosition, MovementConfig.Speed)

                pcall(function()
                    ReplicatedStorage.Package.Events:WaitForChild("Qaction"):InvokeServer(bossNpc)
                end)

                task.wait(0.2)
            end
        end

        -- SE HA PRESO LA QUEST (o se l'aveva già), VA A COMBATTERE
        if questVal.Value == expectedQuestName or questVal.Value == bossData.BossName then
            WaitForBossToSpawn(bossData, 5, bossName)
        end
    else
        WaitForBossToSpawn(bossData, 5, bossName)
    end
end

-- Main Farm Loop
task.spawn(function()
    while true do
        if localPlayer.Character and localPlayer.Character:FindFirstChild("Humanoid") and localPlayer.Character.Humanoid.Health > 0 then
            for bossName, isToggled in pairs(getgenv().BossTargets) do
                if isToggled then
                    CheckAndFightBoss(bossName)
                end
            end
        end
        task.wait(0.5)
    end
end)

