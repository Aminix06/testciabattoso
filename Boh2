-- SISTEMA ANTI-INTRUSO (CAMBIO ZONA VERSO EARTH)
-- ==============================================================================
task.spawn(function()
    repeat task.wait() until game:IsLoaded()

    local function IsPublicServer()
        local jobId = game.JobId
        local placeId = game.PlaceId
        local cursor = ""
        while true do
            local url = "https://games.roblox.com/v1/games/" .. placeId .. "/servers/Public?limit=100&cursor=" .. cursor
            local requestFunc = (syn and syn.request) or (http and http.request) or http_request or request
            if not requestFunc then return true end
            local success, response = pcall(function() return requestFunc({Url = url, Method = "GET"}) end)
            if not success or not response or response.StatusCode ~= 200 then
                task.wait(1)
            else
                local data = HttpService:JSONDecode(response.Body)
                for _, server in ipairs(data.data) do
                    if server.id == jobId then return true end
                end
                cursor = data.nextPageCursor
                if not cursor then break end
            end
            task.wait(0.1)
        end
        return false
    end

    if IsPublicServer() then
        localPlayer:Kick("SEI IN UN SERVER PUBBLICO! Kick di sicurezza attivato.")
    else
        print("🔒 Server Privato confermato. Sensori attivati.")

        -- Cambio di zona: mantiene il TP nativo del gioco (non è movimento locale via CFrame).
        local TPEvent = ReplicatedStorage:WaitForChild("Package"):WaitForChild("Events"):WaitForChild("TP")
        local isEscaping = false

        local function FugaSullaTerra()
            if isEscaping then return end
            isEscaping = true
            warn("⚠️ Intruso rilevato! Cambio zona verso Earth...")

            pcall(function()
                if localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    localPlayer.Character.HumanoidRootPart.Anchored = true
                end
            end)

            pcall(function()
                TPEvent:InvokeServer("Earth")
            end)

            task.delay(5, function()
                localPlayer:Kick("⚠️ Il cambio zona non è riuscito e l'intruso è ancora qui. Disconnessione di emergenza.")
            end)
        end

        if #Players:GetPlayers() > 1 then
            FugaSullaTerra()
        end

        Players.PlayerAdded:Connect(function(player)
            if player.UserId ~= localPlayer.UserId then
                FugaSullaTerra()
            end
        end)

        task.spawn(function()
            while task.wait(1) do
                if #Players:GetPlayers() > 1 then
                    FugaSullaTerra()
                end
            end
        end)
    end
end)

