local function setupCharacter(character)
    local humanoid = character:WaitForChild("Humanoid", 5)
    if humanoid then
        local function updateHealth(health)
            local maxHealth = math.max(1, humanoid.MaxHealth)
            Converted["_health"].Text = formatNumber(math.floor(health))
            Converted["_maxhealth"].Text = formatNumber(math.floor(maxHealth))
            local fill = Converted["_HealthFill"]
            if fill then
                local ratio = math.clamp(health / maxHealth, 0, 1)
                TweenService:Create(fill, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                    Size = UDim2.new(ratio, 0, 1, 0)
                }):Play()
            end
        end
        updateHealth(humanoid.Health)
        humanoid.HealthChanged:Connect(updateHealth)
        humanoid:GetPropertyChangedSignal("MaxHealth"):Connect(function()
            updateHealth(humanoid.Health)
        end)
    end

    task.spawn(function()
        local wsChar = game.Workspace:WaitForChild("Living"):WaitForChild(localPlayer.Name, 10)
        if wsChar then
            local statsFolder = wsChar:WaitForChild("Stats", 5)
            if statsFolder then
                -- currentKi è l'energia che scende (quella che cambia)
                local currentKi = statsFolder:WaitForChild("Ki", 5)

                local function updateEnergy()
                    local val = 0
                    pcall(function()
                        val = tonumber(currentKi.Value) or 0
                        Converted["_energy"].Text = formatNumber(math.floor(val))
                    end)

                    -- In questa interfaccia il massimo visualizzato resta 100, come nella versione precedente.
                    Converted["_maxenergy"].Text = "100"
                    local fill = Converted["_EnergyFill"]
                    if fill then
                        local ratio = math.clamp(val / 100, 0, 1)
                        TweenService:Create(fill, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                            Size = UDim2.new(ratio, 0, 1, 0)
                        }):Play()
                    end
                end

                updateEnergy()

                -- Aggiorna quando il valore del Ki cambia
                if currentKi then
                    currentKi.Changed:Connect(updateEnergy)
                end
            end
        end
    end)
end

