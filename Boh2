-- MOVIMENTO INTERNO: TWEEN RAPIDO, CON ANTI-RIAVVIO
-- ============================================================================
local MovementConfig = {
    Speed = 850,                   -- studs/secondo: valori alti = movimento rapido
    MinDuration = 0.035,           -- evita tween a durata zero
    MaxDuration = 0.45,            -- limite per tragitti lunghi
    TargetRefreshDistance = 2.5,   -- aggiorna il target se si sposta oltre questa soglia
    ArrivalDistance = 0.85,        -- considera raggiunto un target molto vicino
}

local activeMovementTween = nil
local activeMovementTarget = nil

local function CancelCharacterTween()
    if activeMovementTween then
        activeMovementTween:Cancel()
    end

    activeMovementTween = nil
    activeMovementTarget = nil
end

local function TweenCharacterTo(targetCFrame, speed)
    if typeof(targetCFrame) ~= "CFrame" then
        return false
    end

    local character = localPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root or root.Anchored then
        CancelCharacterTween()
        return false
    end

    local distance = (targetCFrame.Position - root.Position).Magnitude
    if distance <= MovementConfig.ArrivalDistance then
        CancelCharacterTween()
        return true
    end

    -- Non ricreare il tween ogni tick: evita vibrazioni e movimenti interrotti.
    if activeMovementTween
        and activeMovementTween.PlaybackState == Enum.PlaybackState.Playing
        and activeMovementTarget
    then
        local targetDrift = (activeMovementTarget.Position - targetCFrame.Position).Magnitude
        if targetDrift <= MovementConfig.TargetRefreshDistance then
            return true
        end

        activeMovementTween:Cancel()
    end

    local movementSpeed = math.max(1, tonumber(speed) or MovementConfig.Speed)
    local duration = math.clamp(
        distance / movementSpeed,
        MovementConfig.MinDuration,
        MovementConfig.MaxDuration
    )

    local tween = TweenService:Create(
        root,
        TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out),
        { CFrame = targetCFrame }
    )

    activeMovementTween = tween
    activeMovementTarget = targetCFrame

    tween.Completed:Connect(function()
        -- Un tween vecchio non deve azzerare i riferimenti di quello nuovo.
        if activeMovementTween == tween then
            activeMovementTween = nil
            activeMovementTarget = nil
        end
    end)

    tween:Play()
    return true
end

localPlayer.CharacterAdded:Connect(function()
