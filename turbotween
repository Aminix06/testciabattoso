local function WaitForTransformation()
	if not getgenv().AutoFarmActive then return end
	local char = localPlayer.Character
	if not char or not char:FindFirstChildOfClass("Humanoid") or char.Humanoid.Health <= 0 then return end

	local folderData = ReplicatedStorage:FindFirstChild("Datas") and ReplicatedStorage.Datas:FindFirstChild(tostring(localPlayer.UserId))
	local status = localPlayer:FindFirstChild("Status") or char:FindFirstChild("Status")

	if folderData and status then
		local defense = folderData:FindFirstChild("Defense")
		local rebirth = folderData:FindFirstChild("Rebirth")
		local actual = status:FindFirstChild("Transformation")

		if defense and rebirth and actual then
			if (tonumber(defense.Value) or 0) >= MIN_DEFENSE and (tonumber(rebirth.Value) or 0) >= MIN_REBIRTH then
				local timeout = 16
				while actual.Value ~= TARGET_FORM and timeout > 0 and getgenv().AutoFarmActive and IsCurrentSession() do
					if not localPlayer.Character or localPlayer.Character:FindFirstChildOfClass("Humanoid").Health <= 0 then return end
					getgenv().UpdateCiabStatus("⚡ Attivazione " .. TARGET_FORM .. "...")
					task.wait(0.5)
					timeout = timeout - 1
				end
			end
		end
	end
end

