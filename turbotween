local function TweenAndFight(bossData, toggleName)
	local playerData = ReplicatedStorage.Datas:FindFirstChild(tostring(localPlayer.UserId))
	local questVal = playerData and playerData:FindFirstChild("Quest")
	behindDistance = bossData.Distance or -5

	task.spawn(EquipAllSkills)

	while IsCurrentSession() and getgenv().AutoFarmActive and getgenv().BossTargets[toggleName] do
		if bossData.QuestNPC and questVal then
			if questVal.Value ~= bossData.QuestNPC and questVal.Value ~= bossData.BossName then
				break
			end
		end

		local currentBoss = getValidBoss(bossData)
		if not currentBoss then break end

		local bossHRP = currentBoss:FindFirstChild("HumanoidRootPart")
		local bossHum = currentBoss:FindFirstChildOfClass("Humanoid")
		local character = localPlayer.Character
		local hrp = character and character:FindFirstChild("HumanoidRootPart")
		if not bossHRP or not bossHum or not hrp then break end

		currentLockedBoss = currentBoss
		local distToBoss = (hrp.Position - bossHRP.Position).Magnitude

		if distToBoss > 25 then
			-- Avvicinamento con Tween se lontano
			getgenv().UpdateCiabStatus("✈️ Tween verso Boss: " .. bossData.BossName)
			local behindOffset = bossHRP.CFrame.LookVector * behindDistance
			local targetCF = CFrame.new(bossHRP.Position + behindOffset, bossHRP.Position)
			pcall(function() MoveToTarget(targetCF, false) end)
		else
			-- Entro 25 studs il Lock-On su RenderStepped tiene la schiena e DoFullAttack colpisce
			local hpPct = math.floor((bossHum.Health / math.max(bossHum.MaxHealth, 1)) * 100)
			getgenv().UpdateCiabStatus(string.format("⚔️ %s [HP: %d%%]", bossData.BossName, hpPct))
			DoFullAttack()
		end

		task.wait(0.12)
	end

	currentLockedBoss = nil
	StopActiveTween()
	pcall(function()
		camera.CameraType = Enum.CameraType.Custom
		if localPlayer.Character and localPlayer.Character:FindFirstChildOfClass("Humanoid") then
			localPlayer.Character:FindFirstChildOfClass("Humanoid").AutoRotate = true
			camera.CameraSubject = localPlayer.Character:FindFirstChildOfClass("Humanoid")
		end
	end)
end

local function WaitForBossToSpawn(bossData, timeLimit, toggleName)
	local startTime = os.time()
	local bossReady = false

	repeat
		if not IsCurrentSession() or not getgenv().AutoFarmActive or not getgenv().BossTargets[toggleName] then return end
		local char = localPlayer.Character
		if not char or not char:FindFirstChildOfClass("Humanoid") or char.Humanoid.Health <= 0 then return end

		task.wait(0.2)
		local currentBoss = getValidBoss(bossData)
		bossReady = (currentBoss ~= nil)
	until bossReady or os.time() - startTime > timeLimit

	if bossReady and getgenv().AutoFarmActive and getgenv().BossTargets[toggleName] then
		task.wait(0.1)
		TweenAndFight(bossData, toggleName)
	end
end

local function CheckAndFightBoss(bossName)
	if not getgenv().AutoFarmActive or not getgenv().BossTargets[bossName] then return end
	local bossData = BossConfig[bossName]
	if not bossData then return end

	WaitForTransformation()

	local character = localPlayer.Character
	if not character or not character:FindFirstChildOfClass("Humanoid") or character.Humanoid.Health <= 0 then return end

	local hrp = character:FindFirstChild("HumanoidRootPart")
	local playerData = ReplicatedStorage.Datas:FindFirstChild(tostring(localPlayer.UserId))
	if not playerData or not hrp then return end

	if bossData.QuestNPC then
		local questVal = playerData:WaitForChild("Quest")
		local bossNpc = workspace.Others.NPCs:FindFirstChild(bossData.QuestNPC)
		local expectedQuestName = bossData.QuestNPC

		if bossNpc and bossNpc:FindFirstChild("HumanoidRootPart") then
			while questVal.Value ~= expectedQuestName and questVal.Value ~= bossData.BossName do
				if not IsCurrentSession() or not getgenv().AutoFarmActive or not getgenv().BossTargets[bossName] then
					StopActiveTween()
					return
				end
				if not localPlayer.Character or localPlayer.Character:FindFirstChildOfClass("Humanoid").Health <= 0 then return end

				currentLockedBoss = nil
				getgenv().UpdateCiabStatus("✈️ Tween verso Quest: " .. bossData.QuestNPC)
				local npcCF = bossNpc.HumanoidRootPart.CFrame * CFrame.new(0, 0, -3)
				MoveToTarget(npcCF, true)

				if (localPlayer.Character.HumanoidRootPart.Position - npcCF.Position).Magnitude <= 12 then
					pcall(function()
						Events:WaitForChild("Qaction"):InvokeServer(bossNpc)
					end)
				end

				task.wait(0.2)
			end
		end

		if questVal.Value == expectedQuestName or questVal.Value == bossData.BossName then
			WaitForBossToSpawn(bossData, 5, bossName)
		end
	else
		WaitForBossToSpawn(bossData, 5, bossName)
	end
end

